{
  "buildCommand": "node -e \"if(process.platform==='linux'){try{require('child_process').execSync('npm i --no-save @rollup/rollup-linux-x64-gnu@4.64.12',{stdio:'inherit'})}catch(e){console.error(e)}}\" && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
