{
  "name": "mavtar-impex-backend",
  "version": "1.0.0",
  "description": "Mavtar Impex Luxury Linen Bags E-Commerce & Super Admin TypeScript Backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "seed": "npx ts-node src/scripts/seed.ts",
    "start": "node dist/src/server.js"
  },
  "keywords": ["mavtar-impex", "luxury-bags", "e-commerce", "api", "typescript"],
  "author": "Mavtar Impex",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
